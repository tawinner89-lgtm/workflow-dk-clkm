generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Intervention {
  id                 String   @id @default(cuid())
  reference          String   @unique
  clientName         String
  clientAddress      String
  clientContactName  String?
  clientContactPhone String?
  technicianName     String
  type               String?
  startTime          String?
  endTime            String?
  problemReported    String?
  workDone           String?
  workDoneOther      String?
  materialsUsed      String?
  blowTemperature    Float?
  functioningTest    Boolean?
  photoBeforeUrl     String?
  photoAfterUrl      String?
  observations       String?
  finalStatus        Boolean?
  signatureTechUrl   String?
  signatureClientUrl String?
  status             String   @default("PLANIFIEE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  intent             String?
  symptom            String?
  ac_type            String?
  units              Int?
  brand              String?
  btu                String?
  budget             Float?
  room_area          Float?
  day                String?
  time_window        String?
  syncHash           String?  @unique

  @@index([createdAt])
  @@index([technicianName, status])
}

model Technician {
  id          String   @id @default(cuid())
  name        String   @unique
  password    String
  createdAt   DateTime @default(now())
  phone       String?
  isAvailable Boolean  @default(true)
}

model BotMessage {
  id        String   @id @default(cuid())
  phone     String
  role      String // 'user' or 'assistant'
  content   String
  createdAt DateTime @default(now())

  @@index([phone])
}

model BotRule {
  id        String   @id @default(cuid())
  rule      String
  createdAt DateTime @default(now())
}

model Inventory {
  id             Int    @id @default(autoincrement())
  brand          String
  btu            String
  ac_type        String @default("Split")
  stock_quantity Int
  price_ttc      Int?

  @@unique([brand, btu, ac_type])
  @@map("Inventory")
}

model SalesLog {
  id                 Int       @id @default(autoincrement())
  timestamp          DateTime  @default(now())
  brand              String
  btu                String
  ac_type            String    @default("Split")
  customer_name      String?
  customer_phone     String?
  customer_address   String?
  status             String?   @default("PENDING")
  notes              String?
  syncHash           String?   @unique
  deliveryNotifiedAt DateTime?

  @@index([status])
  @@map("SalesLog")
}

model DeliverySettings {
  id        Int      @id
  phone     String
  updatedAt DateTime @updatedAt

  @@map("DeliverySettings")
}

model DeliveryRequest {
  saleId    Int      @id
  tokenHash String
  createdAt DateTime @default(now())

  @@map("DeliveryRequest")
}

model Quote {
  id                   String    @id @default(cuid())
  reference            String    @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  customerName         String
  customerPhone        String
  customerAddress      String?
  brand                String
  btu                  String
  acType               String
  modelName            String
  quantity             Int
  unitPrice            Int
  installationPrice    Int       @default(0)
  installationIncluded Boolean   @default(false)
  additionalItems      String    @default("[]")
  status               String    @default("EN_ATTENTE")
  convertedAt          DateTime?

  @@index([createdAt])
  @@index([status])
  @@map("Quote")
}

model StockAddition {
  id            Int      @id @default(autoincrement())
  inventoryId   Int?
  brand         String
  btu           String
  ac_type       String   @default("Split")
  quantityAdded Int
  operation     String   @default("ADD")
  addedBy       String
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@map("StockAddition")
}

model StockMaterial {
  id          Int                @id @default(autoincrement())
  designation String             @unique
  quantity    Int                @default(0)
  price       Decimal?           @db.Decimal(12, 2)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  movements   MaterialMovement[]

  @@map("StockMaterial")
}

model MaterialMovement {
  id             Int            @id @default(autoincrement())
  materialId     Int?
  designation    String
  action         String
  quantityBefore Int?
  quantityAfter  Int?
  priceBefore    Decimal?       @db.Decimal(12, 2)
  priceAfter     Decimal?       @db.Decimal(12, 2)
  performedBy    String
  createdAt      DateTime       @default(now())
  material       StockMaterial? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("MaterialMovement")
}

model InterventionSync {
  hash      String   @id
  createdAt DateTime @default(now())

  @@map("InterventionSync")
}
